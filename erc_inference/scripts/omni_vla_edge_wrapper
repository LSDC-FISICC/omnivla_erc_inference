#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
WORKSPACE_ROOT="$(cd "${PACKAGE_ROOT}/../.." && pwd)"

if [ -f /opt/ros/jazzy/setup.bash ]; then
  source /opt/ros/jazzy/setup.bash
fi

CONDA_SH=""
for candidate in \
  "/opt/conda/etc/profile.d/conda.sh" \
  "/usr/local/anaconda3/etc/profile.d/conda.sh" \
  "/home/${USER}/anaconda3/etc/profile.d/conda.sh" \
  "${HOME}/anaconda3/etc/profile.d/conda.sh" \
  "${HOME}/miniconda3/etc/profile.d/conda.sh" \
  "${HOME}/miniforge3/etc/profile.d/conda.sh"; do
  if [ -f "${candidate}" ]; then
    CONDA_SH="${candidate}"
    break
  fi
done

if [ -n "${CONDA_SH}" ]; then
  source "${CONDA_SH}"
  if command -v conda >/dev/null 2>&1; then
    conda activate omnivla_py312 >/dev/null 2>&1 || true
  fi
fi

PYTHON_BIN="python3"
if ! command -v conda >/dev/null 2>&1; then
  # No conda on this machine (e.g. the Spark): fall back to the plain venv
  # that has OmniVLA's deps (torch/transformers) pip-installed. Override
  # with OMNIVLA_VENV if your venv lives somewhere else.
  OMNIVLA_VENV="${OMNIVLA_VENV:-${HOME}/lsdc/erc-omni-vla/.venv}"
  if [ -x "${OMNIVLA_VENV}/bin/python3" ]; then
    PYTHON_BIN="${OMNIVLA_VENV}/bin/python3"
  fi
fi

if [ -f "${WORKSPACE_ROOT}/install/setup.bash" ]; then
  source "${WORKSPACE_ROOT}/install/setup.bash"
fi

export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${PACKAGE_ROOT}:${WORKSPACE_ROOT}/OmniVLA"

exec "${PYTHON_BIN}" -c "from erc_inference.omnivla_edge_node import main; main()" "$@"
