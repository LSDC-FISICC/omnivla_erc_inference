#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
WORKSPACE_ROOT="$(cd "${PACKAGE_ROOT}/../.." && pwd)"

if [ -f /opt/ros/jazzy/setup.bash ]; then
  source /opt/ros/jazzy/setup.bash
fi

CONDA_SH=""
for candidate in \
  "/opt/conda/etc/profile.d/conda.sh" \
  "/usr/local/anaconda3/etc/profile.d/conda.sh" \
  "/home/${USER}/anaconda3/etc/profile.d/conda.sh" \
  "${HOME}/anaconda3/etc/profile.d/conda.sh" \
  "${HOME}/miniconda3/etc/profile.d/conda.sh" \
  "${HOME}/miniforge3/etc/profile.d/conda.sh"; do
  if [ -f "${candidate}" ]; then
    CONDA_SH="${candidate}"
    break
  fi
done

if [ -n "${CONDA_SH}" ]; then
  source "${CONDA_SH}"
  if command -v conda >/dev/null 2>&1; then
    conda activate omnivla_py312 >/dev/null 2>&1 || true
  fi
fi

PYTHON_BIN="python3"
if ! command -v conda >/dev/null 2>&1; then
  # No conda on this machine (e.g. the Spark): fall back to the plain venv
  # that has OmniVLA's deps (torch/transformers) pip-installed. Override
  # with OMNIVLA_VENV if your venv lives somewhere else.
  OMNIVLA_VENV="${OMNIVLA_VENV:-${HOME}/lsdc/erc-omni-vla/.venv}"
  if [ -x "${OMNIVLA_VENV}/bin/python3" ]; then
    PYTHON_BIN="${OMNIVLA_VENV}/bin/python3"
  fi
fi

if [ -f "${WORKSPACE_ROOT}/install/setup.bash" ]; then
  source "${WORKSPACE_ROOT}/install/setup.bash"
fi

export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${PACKAGE_ROOT}:${WORKSPACE_ROOT}/OmniVLA"

# Motion-controller parameters (controller_type, gains, limits), installed by
# setup.py -- the same file omni_vla_wrapper feeds the edge node, so both models
# run the same control law and a comparison isolates the model. Point
# OMNIVLA_CONTROLLER_CONFIG at another file to replace it, or append
# `--ros-args -p name:=value` to override single values.
CONFIG="${OMNIVLA_CONTROLLER_CONFIG:-}"
if [ -z "$CONFIG" ]; then
    SHARE=$("${PYTHON_BIN}" -c "from ament_index_python.packages import get_package_share_directory as g; print(g('erc_inference'))") || exit 1
    CONFIG="$SHARE/config/controller.yaml"
fi
if [ ! -f "$CONFIG" ]; then
    # Fail loudly: starting on the node's built-in defaults would silently
    # ignore whatever controller the operator thinks they selected.
    echo "omni_vla_original_wrapper: controller config not found: $CONFIG" >&2
    echo "  rebuild with colcon so setup.py installs it, or set OMNIVLA_CONTROLLER_CONFIG" >&2
    exit 1
fi

exec "${PYTHON_BIN}" -c "from erc_inference.omnivla_original_node import main; main()" --ros-args --params-file "$CONFIG" "$@"
