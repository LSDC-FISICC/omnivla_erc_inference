#!/usr/bin/env bash

source /home/$USER/anaconda3/etc/profile.d/conda.sh
conda activate omnivla

# 3. Incluir la carpeta OmniVLA en el PATH de Python
#export PYTHONPATH=$PYTHONPATH:/home/jabes/erc_test_ws/OmniVLA

# Motion-controller parameters (controller_type, gains, limits), installed by
# setup.py. Point OMNIVLA_CONTROLLER_CONFIG at another file to replace it, or
# append `--ros-args -p name:=value` to override single values.
CONFIG="${OMNIVLA_CONTROLLER_CONFIG:-}"
if [ -z "$CONFIG" ]; then
    SHARE=$(python3 -c "from ament_index_python.packages import get_package_share_directory as g; print(g('erc_inference'))") || exit 1
    CONFIG="$SHARE/config/controller.yaml"
fi
if [ ! -f "$CONFIG" ]; then
    # Fail loudly: starting on the node's built-in defaults would silently
    # ignore whatever controller the operator thinks they selected.
    echo "omni_vla_wrapper: controller config not found: $CONFIG" >&2
    echo "  rebuild with colcon so setup.py installs it, or set OMNIVLA_CONTROLLER_CONFIG" >&2
    exit 1
fi

# 4. Ejecutar el nodo en Python
exec python3 -c "from erc_inference.omnivla_edge_node import main; main()" --ros-args --params-file "$CONFIG" "$@"
